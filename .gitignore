.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
.DS_Store
# Raw BBQ, prepared splits and the capability QA file are committed (the GPU machine
# pulls them from git); only the large capability-source downloads are not.
data/downloads/
artifacts/
runs/
reports/
*.pt
*.safetensors


# Run logs, run-state markers and locks stay on the GPU machine: every campaign rewrites
# them, they reach 1.5 GB, and they travel inside the results ZIP instead. A clean tree
# is also what lets the runner pull and push unattended.
logs/
# Locked configs are written on the GPU machine at run time and archived in the ZIP.
# (configs/qwen_gender_gpu_check.locked.json predates this and stays tracked.)
configs/**/*.locked.json
# Machine-specific settings (copy of steerquant.env.example); may hold a token.
steerquant.env
