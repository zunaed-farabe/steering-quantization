# Machine-specific settings. Copy this file to `steerquant.env` (which git ignores) and edit it.
# run_experiment.sh and every `steerquant` command started from this folder read it.
# Variables already set in your shell take precedence over this file.

# Where the Hugging Face model cache lives. Keep it on a large, persistent disk.
HF_HOME=/workspace/farabe/.cache/huggingface

# Optional: Hugging Face token for higher download limits. Never commit it.
# HF_TOKEN=hf_xxx
